{
  "name": "@janhq/assistant-extension",
  "version": "1.0.2",
  "description": "Powers the default AI assistant that works with all your installed models.",
  "main": "dist/index.js",
  "jan": {
    "id": "jan.assistant",
    "displayName": "Jan Assistant",
    "description": "Powers the default AI assistant that works with all your installed models.",
    "publisher": "Jan",
    "apiVersion": "^0.1.0",
    "main": "dist/index.js",
    "permissions": []
  },
  "author": "Jan <service@jan.ai>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "cpx": "1.5.0",
    "jsdom": "^26.1.0",
    "rimraf": "6.0.1",
    "rolldown": "1.0.0-beta.1",
    "run-script-os": "1.1.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@janhq/core": "workspace:*"
  },
  "files": [
    "dist/*",
    "package.json",
    "README.md"
