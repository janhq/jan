{
  "name": "@janhq/litert-lm-extension",
  "productName": "LiteRT-LM Inference Engine",
  "version": "1.0.0",
  "description": "This extension enables Google LiteRT-LM inference on CPU (and accelerators) locally",
  "main": "dist/index.js",
  "module": "dist/module.js",
  "engine": "litert-lm",
  "author": "Jan <service@jan.ai>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "build:publish": "rimraf *.tgz --glob || true && yarn build && npm pack && cpx *.tgz ../../pre-install",
    "test": "vitest run"
  },
  "devDependencies": {
    "cpx": "1.5.0",
    "jsdom": "^26.1.0",
    "rimraf": "3.0.2",
    "rolldown": "1.0.0-beta.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@janhq/core": "workspace:*",
    "@janhq/local-engine": "workspace:*",
    "@janhq/tauri-plugin-local-engine-api": "link:../../src-tauri/plugins/tauri-plugin-local-engine",
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-http": "2.5.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/*",
    "package.json"
  ],
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "packageManager": "yarn@4.5.3"
}
