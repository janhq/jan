{
  "name": "@janhq/extension-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Worker runtime for Jan extensions: typed RPC between the host window and one Web Worker per extension",
  "license": "Apache-2.0",
  "author": "Jan <service@jan.ai>",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prelude-source": {
      "types": "./dist/prelude-source.d.ts",
      "default": "./dist/prelude-source.js"
    },
    "./testing": {
      "types": "./dist/testing/harness.d.ts",
      "default": "./dist/testing/harness.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-prelude.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@janhq/extension-api": "workspace:*",
    "acorn": "^8.15.0",
    "ses": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rolldown": "1.0.0-beta.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "packageManager": "yarn@4.5.3"
}
